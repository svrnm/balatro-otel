    {
      "type": "table",
      "title": "Runs",
      "description": "One row per run (sent when the run ends). Click a trace to see blinds, hands and card evaluations.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"balatro.run\" } | select(span.balatro.run.seed, span.balatro.deck.name, span.balatro.stake, span.balatro.run.outcome, span.balatro.ante, span.balatro.round, span.balatro.dollars, span.balatro.lua.memory.live, span.error.type)",
          "limit": 100,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 12
    },
    {
      "type": "table",
      "title": "Blinds",
      "description": "Each blind with target, score and how smooth it ran.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"balatro.blind\" } | select(span.balatro.blind.name, span.balatro.ante, span.balatro.blind.target, span.balatro.blind.score, span.balatro.blind.won, span.balatro.frame.jank_count, span.balatro.frame.max_duration)",
          "limit": 100,
          "spss": 20,
          "tableType": "spans"
        }
