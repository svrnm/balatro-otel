        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "logs",
      "title": "Crashes",
      "description": "app.crash with exception message and stack trace; expand a line and follow trace_id to the run it interrupted.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"balatro\"} | event_name=\"app.crash\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "id": 15
    },
    {
      "type": "logs",
      "title": "Mod errors & warnings",
      "description": "Steamodded logger output from any mod at WARN or above (scope = logger name), linked to the open span.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"balatro\"} | severity_text=~\"ERROR|WARN|FATAL\" | event_name=\"\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Errors and warnings over time",
      "description": "Log records at WARN and above, including app.jank (WARN) and app.crash (FATAL).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (detected_level) (count_over_time({service_name=\"balatro\"} | detected_level=~\"error|warn|fatal\" [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "id": 17
    },
    {
      "type": "table",
      "title": "Failed spans",
      "description": "Spans ended with status ERROR (a crash cut them short).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"balatro\" && status = error } | select(span.error.type, span.balatro.blind.name, span.balatro.run.seed)",
          "limit": 100,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
