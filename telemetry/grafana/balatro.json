        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (balatro_card_action, balatro_card_set) (max_over_time(balatro_card_actions_total[$__range]))",
          "instant": true,
          "legendFormat": "{{balatro_card_action}} {{balatro_card_set}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
