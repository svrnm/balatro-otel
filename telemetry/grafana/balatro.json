    {
      "type": "bargauge",
      "title": "Hands by type",
      "description": "Counters are cumulative per game session; this sums each session's latest value in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (balatro_hand_type) (max_over_time(balatro_hands_total[$__range]))",
          "instant": true,
          "legendFormat": "{{balatro_hand_type}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
